{
  "tawDevlogs": [
    {
      "id": "devlog-1",
      "num": "01",
      "image": "media/taw-breaker/lighting.jpg",
      "extraImage": "media/taw-breaker/entorno.jpg",
      "title": {
        "es": "Iluminación del Templo y Post-Processing HDR",
        "en": "Temple Lighting & HDR Post-Processing"
      },
      "body": {
        "es": "Consolidación de la atmósfera nocturna del Templo mediante antorchas 3D con luces puntuales dinámicas, fuego estilizado, una tenue luz direccional Moonlight, luz ambiental Trilight para conservar volumen en sombras y calibración de Bloom HDR sobre el Skybox nocturno.",
        "en": "Consolidated the nocturnal Temple atmosphere with 3D torches, dynamic point lights, stylized fire particles, subtle Moonlight directional light, Trilight ambient fill to preserve shadow volume, and calibrated HDR Bloom against the night Skybox."
      },
      "bullets": {
        "es": [
          "Integración de antorchas 3D escaladas a la arquitectura del nivel.",
          "Luces puntuales dinámicas + Moonlight direccional + Trilight ambiente.",
          "Perfil de Post-Processing Bloom calibrado para materiales HDR emisivos."
        ],
        "en": [
          "3D torch models integrated and scaled to temple level architecture.",
          "Dynamic point lights + directional Moonlight + Trilight ambient balance.",
          "HDR Bloom Post-Processing profile tuned for emissive game elements."
        ]
      }
    },
    {
      "id": "devlog-2",
      "num": "02",
      "image": "media/taw-breaker/particles.jpg",
      "extraImage": "media/taw-breaker/portal.jpg",
      "title": {
        "es": "Partículas Elementales, Trails y Portal SwapStation",
        "en": "Elemental Particles, Trails & SwapStation Portal"
      },
      "body": {
        "es": "Estandarización de auras y trails elementales (Fuego, Agua y Planta) en las 6 canicas de ambos jugadores, prefabs de impacto HDR dedicados, lógica en VFXCollisionManager.cs filtrando fricción con el suelo y vórtice radial Rojo→Azul en la SwapStation.",
        "en": "Standardized elemental trails and auras (Fire, Water, Plant) across all 6 player marbles, dedicated HDR hit prefabs, ground-friction filtering in VFXCollisionManager.cs, and a rotating Red→Blue radial vortex for the SwapStation portal."
      },
      "bullets": {
        "es": [
          "Trails y ParticleSystems estandarizados para Fuego, Agua y Planta.",
          "Prefabs de impacto con paletas HDR de alta intensidad por elemento.",
          "VFXCollisionManager.cs disparando VFX estrictamente en impactos tácticos."
        ],
        "en": [
          "Standardized TrailRenderers & ParticleSystems for Fire, Water, and Plant.",
          "High-intensity elemental HDR collision impact prefabs.",
          "VFXCollisionManager.cs filtering floor friction to fire only on tactical hits."
        ]
      }
    },
    {
      "id": "devlog-3",
      "num": "03",
      "image": "media/taw-breaker/shaders.jpg",
      "extraImage": "media/taw-breaker/vfx.jpg",
      "title": {
        "es": "Manipulación Dinámica de Shaders en Colisiones (GlassMarble)",
        "en": "Dynamic Runtime Shader Manipulation (GlassMarble)"
      },
      "body": {
        "es": "Sistema de Damage Flash en tiempo de ejecución accediendo directamente por código a las propiedades del shader GlassMarble (_Tint, _RimColor, _SkyTop) para inyectar destellos HDR absolutos e idénticos al impactar y restaurar el material sin afectar el rendimiento.",
        "en": "Runtime Damage Flash system programmatically overriding GlassMarble shader properties (_Tint, _RimColor, _SkyTop) with absolute HDR bursts on impact, then cleanly restoring original material states with zero frame drops."
      },
      "bullets": {
        "es": [
          "Sobreescritura en tiempo real de _Tint, _RimColor y _SkyTop vía C#.",
          "Valores HDR absolutos para feedback idéntico independientemente del material base.",
          "Corrutina de restauración suave del material tras cada colisión."
        ],
        "en": [
          "Runtime C# override of _Tint, _RimColor, and _SkyTop shader channels.",
          "Absolute HDR flash intensity guaranteeing consistent readability across marbles.",
          "Lightweight restoration routine returning materials to base values smoothly."
        ]
      }
    }
  ],
